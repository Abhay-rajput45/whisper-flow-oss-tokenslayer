# Get a sandbox key: https://docs.pyai.com/quickstart
# Or create a live key at https://console.pyai.com
# Required scopes: hear:stream, nfuse:run (or chat completions)
PYAI_API_KEY=

# --- Text LLM (polish) ----------------------------------------------------
# No provider is hardcoded in the app. Any OpenAI-compatible endpoint works;
# PyAI NFuse below is just the shipped example. Without BASE_URL + MODEL + a
# key, polish is skipped and raw dictation is pasted.
# URL is the COMPLETE endpoint, used verbatim — paste it from the vendor's docs.
# Anything left unset below is omitted from the request, so the server decides.
# Without URL + MODEL + a key, polish is skipped and local cleanup still runs.
TEXT_LLM_URL=https://generativelanguage.googleapis.com/v1beta/openai/chat/completions
TEXT_LLM_MODEL=gemini-flash-lite-latest
TEXT_LLM_API_KEY=                                   # Settings → "Polish API key" overrides this when set
# TEXT_LLM_EXTRA_BODY={}                            # merged last, wins over everything below
# TEXT_LLM_TEMPERATURE=0.2
# TEXT_LLM_MAX_TOKENS=512
# TEXT_LLM_STREAM=0                                 # 1 = ask for SSE (both handled either way)

# Same seam, pointed elsewhere:
#   OpenAI   URL=https://api.openai.com/v1/chat/completions               MODEL=gpt-4o-mini
#   Gemini   URL=https://generativelanguage.googleapis.com/v1beta/openai/chat/completions
#   NIM      URL=https://integrate.api.nvidia.com/v1/chat/completions     MODEL=meta/llama-3.1-70b-instruct
#   Ollama   URL=http://localhost:11434/v1/chat/completions               MODEL=llama3.1

# --- Logging --------------------------------------------------------------
# Terminal output is on by default at info. One switch turns everything off.
# LOG=0                  # master off (also: LOG_LEVEL=silent)
# LOG_LEVEL=debug        # error | warn | info | debug | trace | silent
# LOG_NS=llm.*           # comma-separated namespace globs (default: all)
# LOG_FORMAT=text        # text | json
# LOG_FILE=1             # also append to userData/logs/ (default off)
