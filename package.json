{
  "name": "verbatim",
  "version": "0.1.0",
  "description": "Type with your voice, everywhere — Verbatim dictation on PyAI Hear",
  "main": "dist-electron/main.js",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "start": "electron .",
    "electron:dev": "vite",
    "self-check": "node --experimental-strip-types scripts/self-check.ts",
    "polish-check": "node --experimental-strip-types scripts/polish-check.ts",
    "hear-probe": "node scripts/hear-probe.mjs",
    "mic-probe": "electron scripts/mic-probe.cjs",
    "typecheck": "tsc -p tsconfig.json --noEmit && tsc -p tsconfig.electron.json --noEmit",
    "prestart": "npm run build"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/tokenslayer/whisper-flow-oss-tokenslayer.git"
  },
  "keywords": [
    "dictation",
    "speech-to-text",
    "pyai",
    "wispr",
    "electron",
    "macos"
  ],
  "author": "Verbatim",
  "license": "MIT",
  "engines": {
    "node": ">=20"
  },
  "devDependencies": {
    "@types/node": "^22.13.10",
    "@types/ws": "^8.18.1",
    "electron": "^35.0.1",
    "typescript": "^5.8.2",
    "vite": "^6.2.2",
    "vite-plugin-electron": "^0.29.0",
    "vite-plugin-electron-renderer": "^0.14.6"
  },
  "dependencies": {
    "dotenv": "^16.4.7",
    "ws": "^8.21.3"
  }
}
